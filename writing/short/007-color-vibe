<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Soft Autumn Cheat Sheet</title>
  <style>
    body {
      font-family: sans-serif;
      background: #fffaf3;
      color: #3a2e2a;
      padding: 2rem;
      max-width: 1000px;
      margin: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 2rem;
    }
    th, td {
      border: 1px solid #d2b48c;
      padding: 1rem;
      vertical-align: top;
    }
    th {
      background-color: #f4e4c1;
      color: #3a2e2a;
      text-align: left;
    }
    .color-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 2em;
      margin: 0.3em 0;
      border: 1px solid #999;
      color: #fff;
      font-weight: bold;
      font-size: 0.9em;
      text-shadow: 0 0 2px #000;
    }
    .color-bar.light {
      color: #000;
      text-shadow: none;
    }
    h1 {
      text-align: center;
    }
    .tip {
      background: #fef3dc;
      padding: 1rem;
      border-left: 4px solid #d2b48c;
      margin-bottom: 1rem;
    }
    .images {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .images img {
      width: 150px;
      height: auto;
      border: 1px solid #ccc;
      border-radius: 4px;
    }
    ul {
      padding-left: 1.2em;
      margin: 0;
    }
  </style>
</head>
<body>
  <h1>🍁 Soft Autumn Color & Style Cheat Sheet</h1>

  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Colors (Named + Emoji)</th>
        <th>Textures / Fabrics</th>
        <th>Accessories</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Best Colors</td>
        <td>
          <div class="color-bar" style="background:#e9967a">Soft Coral 👚</div>
          <div class="color-bar" style="background:#d8a39d">Dusty Rose 👗</div>
          <div class="color-bar" style="background:#e2725b">Terracotta 🧣</div>
          <div class="color-bar light" style="background:#8a9a5b">Warm Moss Green 🧥</div>
          <div class="color-bar" style="background:#468382">Muted Teal 👕</div>
          <div class="color-bar light" style="background:#daa520">Goldenrod 🧶</div>
        </td>
        <td><ul><li>Brushed cotton</li><li>Linen</li><li>Soft knit</li><li>Suede</li></ul></td>
        <td><ul><li>Burnished gold</li><li>Antique brass</li><li>Copper</li><li>Rose gold 👜💍</li></ul></td>
      </tr>
      <tr>
        <td>Best Neutrals</td>
        <td>
          <div class="color-bar light" style="background:#f5f5dc">Warm Beige 👚</div>
          <div class="color-bar light" style="background:#fffdd0">Cream 👕</div>
          <div class="color-bar light" style="background:#c19a6b">Camel 👖</div>
          <div class="color-bar light" style="background:#bfa77f">Taupe 🧥</div>
          <div class="color-bar light" style="background:#708238">Olive 🧤</div>
          <div class="color-bar light" style="background:#a39887">Warm Gray 👟</div>
        </td>
        <td><ul><li>Tweed</li><li>Raw silk</li><li>Wool blends</li></ul></td>
        <td><ul><li>Leather (tan/brown)</li><li>Tortoiseshell</li><li>Matte metals 👓🧣</li></ul></td>
      </tr>
      <tr>
        <td>Accent Colors</td>
        <td>
          <div class="color-bar light" style="background:#ffb347">Muted Pumpkin 👕</div>
          <div class="color-bar" style="background:#b7410e">Light Rust 🧣</div>
          <div class="color-bar light" style="background:#b2ac88">Sage 🧥</div>
          <div class="color-bar light" style="background:#ffbf00">Amber 🧤</div>
          <div class="color-bar light" style="background:#ffdab9">Soft Peach 👗</div>
          <div class="color-bar light" style="background:#e0c16d">Soft Ochre 👚</div>
        </td>
        <td><ul><li>Flannel</li><li>Velvet (matte)</li><li>Washed denim</li></ul></td>
        <td><ul><li>Natural stone</li><li>Wood</li><li>Warm enamel accessories 📿🎒</li></ul></td>
      </tr>
      <tr>
        <td>Avoid These</td>
        <td>
          <div class="color-bar" style="background:#000000">True Black 🚫</div>
          <div class="color-bar light" style="background:#ffffff">Pure White 🚫</div>
          <div class="color-bar" style="background:#ff69b4">Neon Pink 🚫</div>
          <div class="color-bar light" style="background:#afeeee">Icy Blue 🚫</div>
          <div class="color-bar" style="background:#0047ab">Bright Cobalt 🚫</div>
          <div class="color-bar" style="background:#ff00ff">Fuchsia 🚫</div>
        </td>
        <td><ul><li>High-shine polyester</li><li>Satin</li><li>Plastic</li></ul></td>
        <td><ul><li>Silver</li><li>Stark black leather</li><li>Glossy finishes ✖️🧳</li></ul></td>
      </tr>
    </tbody>
  </table>

